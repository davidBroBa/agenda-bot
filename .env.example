# Plantilla de variables de entorno. Copiar a .env (que NO se versiona).
# Ninguna de estas variables tiene valor real aqui.

# --- Telegram ---
# Token del bot, obtenido de @BotFather. NO compartir ni commitear.
TELEGRAM_BOT_TOKEN=
# Identificadores de Telegram autorizados, separados por comas.
TELEGRAM_ALLOWED_USER_IDS=
# Secreto que comparte el gateway con n8n en el reenvio interno.
TELEGRAM_GATEWAY_SECRET=

# --- PostgreSQL (contenedor propio) ---
POSTGRES_DB=agenda
POSTGRES_USER=agenda
POSTGRES_PASSWORD=

# --- n8n existente ---
# URL interna del n8n ya presente en el servidor.
N8N_INTERNAL_URL=http://host.docker.internal:5678
N8N_INTERNAL_SECRET=

# --- Ollama local ---
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b

# --- Aplicacion ---
TZ_DEFAULT=America/Mexico_City
LOG_LEVEL=info
